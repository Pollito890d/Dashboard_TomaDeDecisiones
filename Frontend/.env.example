# Plantilla de configuración del frontend Vite.
# Copiar a Frontend/.env para apuntar al backend FastAPI cuando esté disponible.
# NUNCA versionar credenciales reales: .env está ignorado por Git.

# Si la variable está vacía o el archivo no existe, el frontend actual usa su
# adaptador con datos ilustrativos (pendiente de sustituir por datos abiertos reales).
VITE_API_URL=http://localhost:8000
