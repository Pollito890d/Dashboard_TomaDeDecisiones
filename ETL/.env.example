# Plantilla opcional del ETL local (fase III). Copiar a ETL/.env solo si se
# necesita cambiar algún valor; sin este archivo se usan los valores por defecto.
# El ETL local NO usa DATABASE_URL ni credenciales: no agregar secretos aquí.

# Rutas relativas a la raíz del repositorio (o absolutas).
ETL_RAW_DIR=data/raw
ETL_PROCESSED_DIR=data/processed

# Nivel de registro: DEBUG, INFO, WARNING o ERROR.
ETL_LOG_LEVEL=INFO

# Ventana mensual de SH_SOCAPS.xlsm!Series que se exporta (inclusive, YYYY-MM).
# 2024-02 es el primer mes necesario para la ventana de 12 meses de 2025-01.
ETL_CNBV_MES_DESDE=2024-02
ETL_CNBV_MES_HASTA=2025-12
