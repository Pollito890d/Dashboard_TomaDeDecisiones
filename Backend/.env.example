# Plantilla de configuración del backend FastAPI.
# Copiar a Backend/.env y reemplazar los marcadores por valores locales.
# NUNCA versionar credenciales reales: .env está ignorado por Git.

# API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (valores de ejemplo, NO credenciales reales)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=replace_with_db_name
POSTGRES_USER=replace_with_user
POSTGRES_PASSWORD=replace_with_password

# URL completa equivalente (opcional; el backend decidirá qué variable usar)
DATABASE_URL=postgresql://replace_with_user:replace_with_password@localhost:5432/replace_with_db_name
