# Plantilla de configuración del backend FastAPI.
# Copiar a Backend/.env y reemplazar los marcadores por valores locales.
# NUNCA versionar credenciales reales: .env está ignorado por Git.

# API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# PostgreSQL: sustituir la contraseña de ejemplo en Backend/.env.
# Si contiene caracteres especiales, codificarlos para el componente URL.
DATABASE_URL=postgresql+psycopg://dashboard_user:contrasena_de_ejemplo@localhost:5432/dashboard_caja_ahorro
